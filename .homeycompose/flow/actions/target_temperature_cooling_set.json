{
    "highlight": true,
    "title": {
        "en": "Set the cooling temperature"
    },
    "titleFormatted": {
        "en": "Set the cooling temperature to [[target_temperature]]"
    },
    "args": [
        {
            "type": "device",
            "name": "device",
			"filter": "driver_id=zigbee_ac|zigbee_thermostat"
		},
        {
            "name": "target_temperature",
            "title": {
                "en": "Target temperature"
            },
            "type": "range",
            "min": 5,
            "max": 40,
            "step": 0.5,
            "label": "°C",
            "labelDecimals": 1
        }
    ]
}